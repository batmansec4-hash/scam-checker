{
  "name": "scam-checker",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scampk",
      "database_id": "ad1bfddd-abc8-46ca-a185-dc4e3f2eb342"
    }
  ]
}
